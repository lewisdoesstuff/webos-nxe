{
  "name": "xne",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:service": "python3 -m unittest discover -s service -t service -p 'test_*.py'",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "verify": "bun run --parallel check lint format:check test"
  },
  "dependencies": {
    "@vue/runtime-vapor": "3.6.0-rc.8",
    "pinia": "4.0.3",
    "vue": "3.6.0-rc.8"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@vitejs/plugin-vue": "6.0.9",
    "jsdom": "30.0.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "bun@1.3.14"
}
